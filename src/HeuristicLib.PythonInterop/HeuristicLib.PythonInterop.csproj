<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>HEAL.HeuristicLib.PythonInterop</AssemblyName>
        <PackageId>HEAL.HeuristicLib.PythonInterop</PackageId>
        <RootNamespace>HEAL.HeuristicLib.PythonInterop</RootNamespace>
        <Description>Python-facing interop helpers and workflows for HeuristicLib.</Description>
        <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="System.Collections.Immutable" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="pythonnet" Version="3.1.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HeuristicLib.Experimental\HeuristicLib.Experimental.csproj" />
    </ItemGroup>
</Project>
