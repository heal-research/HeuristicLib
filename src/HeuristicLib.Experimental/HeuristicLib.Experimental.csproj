<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>HEAL.HeuristicLib.Experimental</AssemblyName>
        <PackageId>HEAL.HeuristicLib.Experimental</PackageId>
        <RootNamespace>HEAL.HeuristicLib</RootNamespace>
        <Description>Experimental HeuristicLib APIs and research-oriented features.</Description>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="System.Collections.Immutable" />
        <Using Include="HEAL.HeuristicLib.Collections" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AutoDiff" Version="1.2.2" />
        <PackageReference Include="MathNet.Numerics" Version="6.0.0-beta2" />
        <PackageReference Include="TreesearchLib" Version="1.3.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\HeuristicLib\HeuristicLib.csproj" />
    </ItemGroup>
</Project>
